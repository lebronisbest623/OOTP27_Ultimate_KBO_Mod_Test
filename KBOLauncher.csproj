<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KBOLauncher</AssemblyName>
    <RootNamespace>KBOLauncher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="data\seeds\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ocr\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
